---
import type { Game } from "../lib/games";

const { game, index = 0 } = Astro.props as { game: Game; index?: number };
const menuNumber = String(index + 1).padStart(2, "0");
---

<article class="surface group relative flex flex-col overflow-hidden p-3 transition duration-300 hover:-translate-y-1 hover:border-[#C5B49E] hover:shadow-xl">
  <a href={`/games/${game.id}`} class="flex h-full flex-col">
    <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-[#E6DEC8]/70 bg-[#F3EFE6]">
      {game.thumbnail ? (
        <img src={game.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
      ) : (
        <div class="flex h-full flex-col items-center justify-center gap-1 bg-gradient-to-br from-[#F3EFE6] to-[#E6DEC8]/50 p-4 text-center" aria-hidden="true">
          <span class="font-editorial text-3xl italic text-[#B86B4B]">SARA Blend</span>
          <span class="text-xs font-bold tracking-widest text-[#6E5D53]">{game.tags[0]}</span>
        </div>
      )}
      <span class="font-editorial absolute top-3 left-3 rounded-full border border-[#E6DEC8] bg-[#FBF9F5]/95 px-3 py-0.5 text-xs font-semibold italic tracking-widest text-[#2C221E] shadow-xs backdrop-blur-xs">
        Signature
      </span>
    </div>
    <div class="flex flex-1 flex-col justify-between px-2 pt-4 pb-2">
      <div>
        <div class="flex items-center justify-between gap-2 text-[11px] tracking-widest text-[#9C8B7E] uppercase">
          <span>No. {menuNumber}</span>
          <span>{game.publishedAt.replaceAll("-", ".")}</span>
        </div>
        <h3 class="mt-1.5 text-lg font-bold tracking-tight text-[#2C221E] transition group-hover:text-[#B86B4B]">{game.title}</h3>
        <p class="mt-2 line-clamp-2 min-h-11 text-xs leading-relaxed text-[#6E5D53]">{game.description}</p>
      </div>
      <div class="mt-4 border-t border-dashed border-[#E6DEC8] pt-3">
        <ul class="flex flex-wrap gap-1.5" aria-label="ジャンル">
          {game.tags.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-[#F3EFE6] px-2.5 py-0.5 text-[11px] font-medium text-[#6E5D53]">#{tag}</li>
          ))}
        </ul>
      </div>
    </div>
  </a>
</article>
