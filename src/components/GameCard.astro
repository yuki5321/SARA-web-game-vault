---
import type { Game } from "../lib/games";

const { game } = Astro.props as { game: Game };
---

<article class="surface group overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
  <a href={`/games/${game.id}`} class="block h-full">
    <div class="aspect-[4/3] overflow-hidden bg-violet-50">
      {game.thumbnail ? (
        <img src={game.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
      ) : (
        <div class="grid h-full place-items-center text-5xl font-black text-violet-300" aria-hidden="true">遊</div>
      )}
    </div>
    <div class="p-4">
      <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-violet-700">{game.title}</h3>
      <p class="mt-2 line-clamp-2 min-h-12 text-sm leading-6 text-slate-600">{game.description}</p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label="ジャンル">
        {game.tags.slice(0, 3).map((tag) => (
          <li class="rounded-full bg-violet-50 px-2.5 py-1 text-xs font-semibold text-violet-700">{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>
