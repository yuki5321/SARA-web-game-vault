---
import type { Game } from "../lib/games";

const { game, index = 0 } = Astro.props as { game: Game; index?: number };
const codeNumber = String(index + 1).padStart(2, "0");
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-[#1E2438] bg-[#0C0E16]/90 transition duration-300 ease-out hover:-translate-y-1 hover:border-[#00F0FF]/55 hover:shadow-[0_14px_34px_-10px_rgba(0,0,0,0.85),0_0_20px_-4px_rgba(0,240,255,0.22)]">
  <a href={`/games/${game.id}`} class="flex h-full flex-col focus:outline-none">
    <!-- Thumbnail Header (Image-first Hero Area) -->
    <div class="relative aspect-[4/3] w-full overflow-hidden border-b border-[#1E2438]/80 bg-[#06070B]">
      {game.thumbnail ? (
        <img
          src={game.thumbnail}
          alt={game.title}
          loading="lazy"
          class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full flex-col items-center justify-center gap-1.5 bg-gradient-to-br from-[#0C0E16] to-[#161A29] p-4 text-center" aria-hidden="true">
          <span class="font-cyber text-2xl font-bold tracking-widest text-[#00F0FF]">NOEL</span>
          <span class="text-xs font-bold tracking-widest text-[#9CA3B8]">{game.tags[0]}</span>
        </div>
      )}

      <!-- Subtle bottom vignette for depth -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#0C0E16]/80 to-transparent"></div>

      <!-- Top-left index badge -->
      <span class="font-mono-tech absolute top-3 left-3 rounded-md border border-[#1E2438] bg-[#06070B]/85 px-2.5 py-0.5 text-[11px] font-bold tracking-widest text-[#00F0FF] backdrop-blur-md transition group-hover:border-[#00F0FF]/40">
        #{codeNumber}
      </span>

      {game.externalUrl && (
        <span class="font-mono-tech absolute top-3 right-3 rounded-md border border-[#A855F7]/40 bg-[#06070B]/85 px-2.5 py-0.5 text-[10px] font-bold tracking-wider text-[#C084FC] backdrop-blur-md">
          WEB APP ↗
        </span>
      )}
    </div>

    <!-- Card Body -->
    <div class="flex flex-1 flex-col justify-between p-5">
      <div>
        <h3 class="text-lg font-extrabold leading-snug tracking-tight text-[#F4F6FB] transition duration-200 group-hover:text-[#00F0FF]">
          {game.title}
        </h3>
        <p class="mt-2 line-clamp-2 min-h-10 text-xs leading-relaxed text-[#9CA3B8]">
          {game.description}
        </p>
        <div class="mt-3 inline-flex items-center gap-1.5 rounded-md border border-[#00F0FF]/25 bg-[#00F0FF]/6 px-2.5 py-1 text-[11px] font-medium text-[#9CA3B8]">
          <span class="size-1.5 rounded-full bg-[#00F0FF] shadow-[0_0_6px_#00F0FF]" aria-hidden="true"></span>
          <span>
            <strong class="font-mono-tech font-bold text-[#00F0FF]" data-play-count={game.id}>---</strong>人が遊びました
          </span>
        </div>
      </div>

      <!-- Card Footer: Tags & PLAY CTA -->
      <div class="mt-5 flex items-center justify-between gap-3 border-t border-[#1E2438]/80 pt-3.5">
        <ul class="flex flex-wrap items-center gap-1.5" aria-label="カテゴリー">
          {game.tags.slice(0, 2).map((tag) => (
            <li class="rounded-md border border-[#1E2438] bg-[#111420] px-2 py-0.5 text-[11px] font-medium text-[#9CA3B8]">
              #{tag}
            </li>
          ))}
        </ul>

        <span class="font-cyber inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-[#00F0FF]/45 bg-[#00F0FF]/10 px-3.5 py-1.5 text-xs font-bold tracking-wider text-[#00F0FF] transition duration-200 group-hover:border-[#00F0FF] group-hover:bg-[#00F0FF] group-hover:text-[#06070B] group-hover:shadow-[0_0_14px_rgba(0,240,255,0.4)]">
          <span>PLAY</span>
          <span aria-hidden="true" class="text-[10px]">▶</span>
        </span>
      </div>
    </div>
  </a>
</article>
