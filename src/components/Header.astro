---
const { gameCount } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-[#E6DEC8] bg-[#FBF9F5]/90 backdrop-blur-md">
  <div class="page-shell flex min-h-20 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3.5 text-[#2C221E]" aria-label="SARA Game Park ホーム">
      <span class="font-editorial grid size-10 place-items-center rounded-full border border-[#2C221E] bg-[#2C221E] text-xl italic text-[#FBF9F5] transition group-hover:bg-[#B86B4B] group-hover:border-[#B86B4B]" aria-hidden="true">S</span>
      <div class="flex flex-col">
        <span class="font-editorial text-2xl font-semibold tracking-wider leading-none">SARA Game Park</span>
        <span class="mt-0.5 text-[10px] tracking-[0.22em] text-[#9C8B7E] uppercase">Playful Blend &amp; Arcade</span>
      </div>
    </a>
    <nav class="flex items-center gap-5 text-sm font-medium text-[#6E5D53]" aria-label="メインナビゲーション">
      <a class="transition hover:text-[#2C221E]" href="/#games">Menu / ゲーム一覧</a>
      <span class="cafe-pill">
        <span class="size-1.5 rounded-full bg-[#B86B4B]"></span>
        <span>Today's Blend: {gameCount}</span>
      </span>
    </nav>
  </div>
</header>
