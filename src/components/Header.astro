---
const { gameCount } = Astro.props;
---

<header class="border-b border-slate-200 bg-white">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-black tracking-tight text-slate-900" aria-label="Webゲーム倉庫 ホーム">
      <span class="grid size-9 place-items-center rounded-xl bg-violet-600 text-lg text-white" aria-hidden="true">W</span>
      <span>Webゲーム倉庫</span>
    </a>
    <nav class="flex items-center gap-4 text-sm font-semibold text-slate-600" aria-label="メインナビゲーション">
      <a class="hover:text-violet-700" href="/#games">ゲーム一覧</a>
      <span class="rounded-full bg-violet-50 px-3 py-1 text-violet-700">{gameCount}本</span>
    </nav>
  </div>
</header>
