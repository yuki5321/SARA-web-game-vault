---
const { gameCount } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-[#1E2438] bg-[#06070B]/85 backdrop-blur-xl">
  <div class="page-shell flex min-h-20 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3.5 text-[#F4F6FB]" aria-label="Noel ホーム">
      <span class="font-cyber relative grid size-10 place-items-center rounded-xl border border-[#00F0FF]/50 bg-[#0C0E16] text-lg font-black text-[#00F0FF] shadow-[0_0_15px_rgba(0,240,255,0.25)] transition group-hover:border-[#00F0FF] group-hover:bg-[#00F0FF] group-hover:text-[#06070B]" aria-hidden="true">
        N
      </span>
      <div class="flex flex-col">
        <span class="font-cyber text-2xl font-extrabold tracking-widest leading-none text-white">NOEL</span>
        <span class="font-mono-tech mt-1 text-[10px] tracking-[0.25em] text-[#00F0FF]/80 uppercase">Cyber Arcade Portal</span>
      </div>
    </a>
    <nav class="flex items-center gap-4 sm:gap-6 text-sm font-semibold text-[#9CA3B8]" aria-label="メインナビゲーション">
      <a class="font-cyber text-xs tracking-widest uppercase transition hover:text-[#00F0FF]" href="/#games">Games</a>
      <span class="cyber-pill">
        <span class="size-2 rounded-full bg-[#00F0FF] shadow-[0_0_8px_#00F0FF]"></span>
        <span class="font-mono-tech text-xs text-[#F4F6FB]">ONLINE: {gameCount}</span>
      </span>
    </nav>
  </div>
</header>
