---
import AdBanner from "../../components/AdBanner.astro";
import GameCard from "../../components/GameCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGames } from "../../lib/games";

const games = getGames();
export function getStaticPaths() {
  return getGames().map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const relatedGames = games
  .filter((candidate) => candidate.id !== game.id)
  .map((candidate) => ({ game: candidate, overlap: candidate.tags.filter((tag) => game.tags.includes(tag)).length }))
  .filter((candidate) => candidate.overlap > 0)
  .sort((left, right) => right.overlap - left.overlap || left.game.id.localeCompare(right.game.id))
  .slice(0, 3)
  .map((candidate) => candidate.game);
const description = `${game.title}の遊び方、コツを紹介。ブラウザーですぐに遊べる無料ゲームです。${game.description}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: game.title,
  description: game.description,
  genre: game.tags,
  author: { "@type": "Person", name: game.author },
  datePublished: game.publishedAt,
  gamePlatform: "Web browser",
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  url: Astro.site ? new URL(`/games/${game.id}/`, Astro.site).href : undefined,
};
---

<BaseLayout title={game.title} description={description} gameCount={games.length} canonicalPath={`/games/${game.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  <article class="page-shell py-8 sm:py-12">
    <a href="/#games" class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-[#6E5D53] transition hover:text-[#2C221E]">
      <span aria-hidden="true">←</span>
      <span>BACK TO MENU / ゲーム一覧に戻る</span>
    </a>
    <header class="mt-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#E6DEC8] pb-5">
      <div>
        <p class="eyebrow">{game.tags.map((t) => `#${t}`).join("  ")}</p>
        <h1 class="mt-1.5 font-['Shippori_Mincho',serif] text-2xl font-bold text-[#2C221E] sm:text-3xl">{game.title}</h1>
      </div>
      {game.externalUrl ? (
        <a
          href={game.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-espresso"
        >
          <span>専用ページで遊ぶ</span>
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`/games/${game.id}/game.html`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-espresso !py-2 !px-4 text-xs font-bold sm:text-sm"
          >
            <span>⛶ 全画面で遊ぶ</span>
            <span aria-hidden="true">↗</span>
          </a>
          <button id="reload-game" class="btn-outline-cafe cursor-pointer !py-2 !px-3.5 text-xs sm:text-sm" type="button">↻ 再読み込み</button>
        </div>
      )}
    </header>

    {game.externalUrl ? (
      <div class="mx-auto mt-8 max-w-4xl">
        <div class="surface overflow-hidden p-4 sm:p-6">
          <div class="relative overflow-hidden rounded-2xl border border-[#E6DEC8] bg-[#2C221E]">
            {game.thumbnail && (
              <img
                src={game.thumbnail}
                alt={game.title}
                class="aspect-[16/10] w-full object-cover opacity-85 transition duration-500 hover:scale-[1.02]"
              />
            )}
            <div class=" inset-0 flex flex-col items-center justify-end bg-gradient-to-t from-[#1E1612]/95 via-[#1E1612]/50 to-transparent p-6 text-center text-[#FBF9F5] sm:absolute sm:p-10">
              <span class="font-editorial rounded-full border border-[#E6DEC8]/40 bg-[#2C221E]/80 px-3.5 py-1 text-xs italic tracking-widest text-[#E6DEC8] backdrop-blur-xs">
                Special Web App · Fullscreen Recommended
              </span>
              <h2 class="mt-3 font-['Shippori_Mincho',serif] text-xl font-bold sm:text-3xl">
                {game.title}
              </h2>
              <p class="mt-2 max-w-lg text-xs leading-relaxed text-[#E6DEC8]/90 sm:text-sm">
                このゲームはオンラインランキング＆物理キーボード対応の専用特設サイトで公開されています。下のボタンから全画面で快適にお楽しみください！
              </p>
              <a
                href={game.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#FBF9F5] px-7 py-3.5 text-sm font-bold tracking-wider text-[#2C221E] shadow-lg transition hover:-translate-y-0.5 hover:bg-[#B86B4B] hover:text-[#FBF9F5]"
              >
                <span>▶ ゲームを起動する（特設サイトを開く）</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class={`mx-auto mt-8 w-full ${game.orientation === "portrait" ? "max-w-lg" : "max-w-4xl"}`}>
        <div class="surface overflow-hidden p-2 sm:p-3" style={`--game-aspect: ${game.aspectRatio}`}>
          <div class="overflow-hidden rounded-xl border border-[#E6DEC8]">
            <iframe
              id="game-frame"
              class="game-frame"
              title={`${game.title} ゲーム画面`}
              src={`/games/${game.id}/game.html`}
              allow="fullscreen"
              loading="eager"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>
      </div>
    )}
    <div class="mx-auto mt-10 max-w-4xl"><AdBanner placement="ゲーム画面下部" /></div>

    <section class="prose-copy surface mx-auto mt-8 max-w-4xl p-6 sm:p-10">
      <p class="eyebrow">Recipe &amp; Guide</p>
      <h2 class="!mt-1">ゲームの概要</h2>
      <p class="whitespace-pre-line">{game.description}</p>
      <h2>遊び方</h2>
      <p class="whitespace-pre-line">{game.howToPlay}</p>
      {game.tips && <><h2>攻略のコツ</h2><p class="whitespace-pre-line">{game.tips}</p></>}
      <p class="text-xs text-[#9C8B7E]">※ 操作に反応しない場合は、ゲーム画面を一度タップしてから操作してください。ゲームの記録はこのブラウザー内に保存されます。</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-dashed border-[#E6DEC8] pt-4 text-xs text-[#9C8B7E]">
        <span>
          Roasted by: <strong class="text-[#6E5D53]">{game.author}</strong>
          <a
            href="https://linktr.ee/sara_wallpaper68"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 inline-flex items-center gap-1 font-bold text-[#B86B4B] underline underline-offset-4 hover:text-[#2C221E]"
          >
            Official Links (Linktree) ↗
          </a>
        </span>
        <span>Date: <time datetime={game.publishedAt}>{game.publishedAt.replaceAll("-", ".")}</time></span>
      </div>
    </section>

    {relatedGames.length > 0 && (
      <section class="mt-14">
        <p class="eyebrow">Recommended</p>
        <h2 class="mt-1 font-['Shippori_Mincho',serif] text-2xl font-semibold text-[#2C221E]">こちらのゲームもおすすめ</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedGames.map((relatedGame) => <GameCard game={relatedGame} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const reloadButton = document.querySelector<HTMLButtonElement>("#reload-game");
  const gameFrame = document.querySelector<HTMLIFrameElement>("#game-frame");
  reloadButton?.addEventListener("click", () => {
    if (gameFrame) gameFrame.src = gameFrame.src;
  });
</script>
