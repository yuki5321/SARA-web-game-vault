---
import AdBanner from "../../components/AdBanner.astro";
import GameCard from "../../components/GameCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGames } from "../../lib/games";

const games = getGames();
export function getStaticPaths() {
  return getGames().map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const relatedGames = games
  .filter((candidate) => candidate.id !== game.id)
  .map((candidate) => ({ game: candidate, overlap: candidate.tags.filter((tag) => game.tags.includes(tag)).length }))
  .filter((candidate) => candidate.overlap > 0)
  .sort((left, right) => right.overlap - left.overlap || left.game.id.localeCompare(right.game.id))
  .slice(0, 3)
  .map((candidate) => candidate.game);
const description = `${game.title}の遊び方、コツを紹介。ブラウザーですぐに遊べる無料ゲームです。${game.description}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: game.title,
  description: game.description,
  genre: game.tags,
  author: { "@type": "Person", name: game.author },
  datePublished: game.publishedAt,
  gamePlatform: "Web browser",
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  url: Astro.site ? new URL(`/games/${game.id}/`, Astro.site).href : undefined,
};
---

<BaseLayout title={game.title} description={description} gameCount={games.length} canonicalPath={`/games/${game.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  <article class="page-shell py-8 sm:py-12">
    <a href="/#games" class="font-mono-tech inline-flex items-center gap-2 text-xs font-bold tracking-wider text-[#9CA3B8] transition hover:text-[#00F0FF]">
      <span aria-hidden="true">←</span>
      <span>BACK TO ARCADE COLLECTION</span>
    </a>
    <header class="mt-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#1E2438] pb-5">
      <div>
        <p class="eyebrow">{game.tags.map((t) => `#${t}`).join("  ")}</p>
        <h1 class="mt-1.5 text-2xl font-black text-[#F4F6FB] sm:text-3xl">{game.title}</h1>
      </div>
      {game.externalUrl ? (
        <a
          href={game.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-neon"
        >
          <span>専用ページで遊ぶ</span>
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <button id="reload-game" class="btn-outline-cyber cursor-pointer" type="button">↻ ゲームを再読み込み</button>
      )}
    </header>

    {game.externalUrl ? (
      <div class="mx-auto mt-8 max-w-4xl">
        <div class="surface-cyber overflow-hidden p-4 sm:p-6">
          <div class="relative overflow-hidden rounded-xl border border-[#1E2438] bg-[#06070B]">
            {game.thumbnail && (
              <img
                src={game.thumbnail}
                alt={game.title}
                class="aspect-[16/10] w-full object-cover opacity-80 transition duration-500 hover:scale-[1.02]"
              />
            )}
            <div class="inset-0 flex flex-col items-center justify-end bg-gradient-to-t from-[#06070B] via-[#06070B]/70 to-transparent p-6 text-center text-[#F4F6FB] sm:absolute sm:p-10">
              <span class="font-mono-tech rounded-md border border-[#00F0FF]/40 bg-[#0C0E16]/90 px-3 py-1 text-xs font-bold tracking-widest text-[#00F0FF] backdrop-blur-md">
                EXTERNAL APP // FULLSCREEN RECOMMENDED
              </span>
              <h2 class="mt-3 text-xl font-black sm:text-3xl">
                {game.title}
              </h2>
              <p class="mt-2 max-w-lg text-xs leading-relaxed text-[#9CA3B8] sm:text-sm">
                このゲームはオンラインランキング＆物理キーボード対応の専用特設サイトで公開されています。下のボタンから全画面で快適にお楽しみください！
              </p>
              <a
                href={game.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-neon mt-5"
              >
                <span>▶ ゲームを起動する（特設サイトを開く）</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class={`mx-auto mt-8 w-full ${game.id === 'takoyaki-gunkann' ? 'max-w-md md:max-w-4xl' : (game.orientation === "portrait" ? "max-w-lg" : "max-w-4xl")}`}>
        <div class="surface-cyber overflow-hidden p-2 sm:p-3" style={game.id !== 'takoyaki-gunkann' ? `--game-aspect: ${game.aspectRatio}` : undefined}>
          <div class="overflow-hidden rounded-xl border border-[#1E2438]">
            <iframe
              id="game-frame"
              class={`game-frame ${game.id === 'takoyaki-gunkann' ? 'game-frame-hybrid' : ''}`}
              title={`${game.title} ゲーム画面`}
              src={`/games/${game.id}/game.html`}
              allow="fullscreen"
              loading="eager"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>
      </div>
    )}
    <div class="mx-auto mt-10 max-w-4xl"><AdBanner placement="ゲーム画面下部" /></div>

    <section class="prose-copy surface mx-auto mt-8 max-w-4xl p-6 sm:p-10">
      <p class="eyebrow">// Briefing &amp; Manual</p>
      <h2 class="!mt-1">ゲームの概要</h2>
      <p class="whitespace-pre-line">{game.description}</p>
      <h2>遊び方</h2>
      <p class="whitespace-pre-line">{game.howToPlay}</p>
      {game.tips && <><h2>攻略のコツ</h2><p class="whitespace-pre-line">{game.tips}</p></>}
      <p class="text-xs text-[#5D647A]">※ 操作に反応しない場合は、ゲーム画面を一度タップしてから操作してください。ゲームの記録はこのブラウザー内に保存されます。</p>
      <div class="font-mono-tech mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[#1E2438] pt-4 text-xs text-[#5D647A]">
        <span>DEVELOPER: <strong class="text-[#9CA3B8]">{game.author}</strong></span>
        <span>RELEASE: <time datetime={game.publishedAt}>{game.publishedAt.replaceAll("-", ".")}</time></span>
      </div>
    </section>

    {relatedGames.length > 0 && (
      <section class="mt-14">
        <p class="eyebrow">// Related Titles</p>
        <h2 class="mt-1 text-2xl font-black text-[#F4F6FB]">こちらのゲームもおすすめ</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedGames.map((relatedGame, idx) => <GameCard game={relatedGame} index={idx} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const reloadButton = document.querySelector<HTMLButtonElement>("#reload-game");
  const gameFrame = document.querySelector<HTMLIFrameElement>("#game-frame");
  reloadButton?.addEventListener("click", () => {
    if (gameFrame) gameFrame.src = gameFrame.src;
  });
</script>
