---
import AdBanner from "../../components/AdBanner.astro";
import GameCard from "../../components/GameCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGames } from "../../lib/games";

const games = getGames();
export function getStaticPaths() {
  return getGames().map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const relatedGames = games
  .filter((candidate) => candidate.id !== game.id)
  .map((candidate) => ({ game: candidate, overlap: candidate.tags.filter((tag) => game.tags.includes(tag)).length }))
  .filter((candidate) => candidate.overlap > 0)
  .sort((left, right) => right.overlap - left.overlap || left.game.id.localeCompare(right.game.id))
  .slice(0, 3)
  .map((candidate) => candidate.game);
const description = `${game.title}の遊び方、コツを紹介。ブラウザーですぐに遊べる無料ゲームです。${game.description}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: game.title,
  description: game.description,
  genre: game.tags,
  author: { "@type": "Person", name: game.author },
  datePublished: game.publishedAt,
  gamePlatform: "Web browser",
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  url: Astro.site ? new URL(`/games/${game.id}/`, Astro.site).href : undefined,
};
---

<BaseLayout title={game.title} description={description} gameCount={games.length} canonicalPath={`/games/${game.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  <article class="page-shell py-8 sm:py-12">
    <a href="/#games" class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-[#6E5D53] transition hover:text-[#2C221E]">
      <span aria-hidden="true">←</span>
      <span>BACK TO MENU / ゲーム一覧に戻る</span>
    </a>
    <header class="mt-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#E6DEC8] pb-5">
      <div>
        <p class="eyebrow">{game.tags.map((t) => `#${t}`).join("  ")}</p>
        <h1 class="mt-1.5 font-['Shippori_Mincho',serif] text-2xl font-bold text-[#2C221E] sm:text-3xl">{game.title}</h1>
      </div>
      <button id="reload-game" class="btn-outline-cafe cursor-pointer" type="button">↻ ゲームを再読み込み</button>
    </header>

    <div class={`mx-auto mt-8 w-full ${game.orientation === "portrait" ? "max-w-lg" : "max-w-4xl"}`}>
      <div class="surface overflow-hidden p-2 sm:p-3" style={`--game-aspect: ${game.aspectRatio}`}>
        <div class="overflow-hidden rounded-xl border border-[#E6DEC8]">
          <iframe
            id="game-frame"
            class="game-frame"
            title={`${game.title} ゲーム画面`}
            src={`/games/${game.id}/game.html`}
            allow="fullscreen"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
    </div>
    <div class="mx-auto mt-10 max-w-4xl"><AdBanner placement="ゲーム画面下部" /></div>

    <section class="prose-copy surface mx-auto mt-8 max-w-4xl p-6 sm:p-10">
      <p class="eyebrow">Recipe &amp; Guide</p>
      <h2 class="!mt-1">ゲームの概要</h2>
      <p class="whitespace-pre-line">{game.description}</p>
      <h2>遊び方</h2>
      <p class="whitespace-pre-line">{game.howToPlay}</p>
      {game.tips && <><h2>攻略のコツ</h2><p class="whitespace-pre-line">{game.tips}</p></>}
      <p class="text-xs text-[#9C8B7E]">※ 操作に反応しない場合は、ゲーム画面を一度タップしてから操作してください。ゲームの記録はこのブラウザー内に保存されます。</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-dashed border-[#E6DEC8] pt-4 text-xs text-[#9C8B7E]">
        <span>Roasted by: <strong class="text-[#6E5D53]">{game.author}</strong></span>
        <span>Date: <time datetime={game.publishedAt}>{game.publishedAt.replaceAll("-", ".")}</time></span>
      </div>
    </section>

    {relatedGames.length > 0 && (
      <section class="mt-14">
        <p class="eyebrow">Recommended</p>
        <h2 class="mt-1 font-['Shippori_Mincho',serif] text-2xl font-semibold text-[#2C221E]">こちらのゲームもおすすめ</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedGames.map((relatedGame) => <GameCard game={relatedGame} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const reloadButton = document.querySelector<HTMLButtonElement>("#reload-game");
  const gameFrame = document.querySelector<HTMLIFrameElement>("#game-frame");
  reloadButton?.addEventListener("click", () => {
    if (gameFrame) gameFrame.src = gameFrame.src;
  });
</script>
