---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" gameCount={getGames().length}>
  <section class="page-shell py-16 sm:py-24">
    <div class="surface mx-auto max-w-xl p-8 text-center sm:p-12">
      <p class="eyebrow">404 Not Found</p>
      <h1 class="mt-2 font-['Shippori_Mincho',serif] text-3xl font-semibold text-[#2C221E]">ページが見つかりません</h1>
      <p class="mt-4 text-sm leading-7 text-[#6E5D53]">ページが移動または削除されたか、URLが間違っている可能性があります。</p>
      <a href="/" class="btn-espresso mt-7">メニューへ戻る</a>
    </div>
  </section>
</BaseLayout>
