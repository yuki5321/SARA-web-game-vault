---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" gameCount={getGames().length}>
  <section class="page-shell py-16 sm:py-24">
    <div class="surface-cyber mx-auto max-w-xl p-8 text-center sm:p-12">
      <p class="eyebrow">// ERROR 404</p>
      <h1 class="mt-2 text-3xl font-black text-[#F4F6FB]">ページが見つかりません</h1>
      <p class="mt-4 text-sm leading-7 text-[#9CA3B8]">ページが移動または削除されたか、URLが間違っている可能性があります。</p>
      <a href="/" class="btn-neon mt-7">トップへ戻る</a>
    </div>
  </section>
</BaseLayout>
