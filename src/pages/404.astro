---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" gameCount={getGames().length}>
  <section class="page-shell py-16 sm:py-24">
    <div class="surface mx-auto max-w-xl p-8 text-center sm:p-12">
      <p class="eyebrow">404 Not Found</p>
      <h1 class="mt-2 text-3xl font-black text-slate-900">ページが見つかりません</h1>
      <p class="mt-4 leading-7 text-slate-600">ページが移動または削除されたか、URLが間違っている可能性があります。</p>
      <a href="/" class="mt-7 inline-flex rounded-xl bg-violet-600 px-5 py-3 font-bold text-white hover:bg-violet-700">ゲーム一覧へ戻る</a>
    </div>
  </section>
</BaseLayout>
