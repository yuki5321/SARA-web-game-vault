---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";
---

<BaseLayout title="お問い合わせ" description="Noelへのお問い合わせ窓口のご案内。" gameCount={getGames().length} canonicalPath="/contact">
  <section class="page-shell py-12 sm:py-16">
    <div class="surface-cyber mx-auto max-w-2xl p-8 text-center sm:p-12">
      <p class="eyebrow">// Contact</p>
      <h1 class="mt-1 text-3xl font-black text-[#F4F6FB]">お問い合わせ</h1>
      <p class="mt-5 text-sm leading-7 text-[#9CA3B8]">お問い合わせフォームは現在準備中です。公開までお待ちください。</p>
      <p class="mt-2 text-xs text-[#5D647A]">フォームの準備ができ次第、このページからご案内します。</p>
      <a href="/" class="btn-neon mt-8">トップページへ戻る</a>
    </div>
  </section>
</BaseLayout>
