---
import AdBanner from "../components/AdBanner.astro";
import CafeBgmPlayer from "../components/CafeBgmPlayer.astro";
import GameCard from "../components/GameCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";

const games = getGames();
const tags = [...new Set(games.flatMap((game) => game.tags))].sort((a, b) => a.localeCompare(b, "ja"));
const description = "インストール不要、ブラウザですぐ遊べる無料ミニゲームカフェ。コーヒーブレイクのお供に、スマートフォンでもPCでも気軽に楽しめます。";
---

<BaseLayout title="SARA Game Park" description={description} gameCount={games.length}>
  <section class="page-shell pt-8 sm:pt-12">
    <div class="surface-warm relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute -top-20 -right-20 size-72 rounded-full bg-[#E6DEC8]/40 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 size-64 rounded-full bg-[#B86B4B]/10 blur-3xl"></div>

      <div class="relative z-10 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#E6DEC8] bg-[#FBF9F5] px-3.5 py-1 text-xs font-medium tracking-wider text-[#6E5D53]">
            <span class="font-editorial italic text-[#B86B4B]">Seoul Cafe Mood</span>
            <span>·</span>
            <span>インストール不要・無料</span>
          </div>
          <p class="font-editorial mt-5 text-sm italic tracking-[0.2em] text-[#9C8B7E] uppercase">A Little Break with Browser Games</p>
          <h1 class="mt-2 font-['Shippori_Mincho',serif] text-3xl font-semibold leading-snug tracking-tight text-[#2C221E] sm:text-5xl sm:leading-tight">
            カフェでひと息つくように、<br class="hidden sm:block" />気軽に遊べるゲームパーク。
          </h1>
          <p class="mt-5 max-w-xl text-sm leading-7 text-[#6E5D53] sm:text-base">
            お気に入りのドリンクとカフェジャズを片手に楽しめる、ブラウザ完結のオリジナルゲームをセレクト。スマホでもPCでも、ページを開けばすぐにスタートできます。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#games" class="btn-espresso">
              <span>Today's Menu を見る</span>
              <span aria-hidden="true">↓</span>
            </a>
            <a href="#cafe-bgm" class="btn-outline-cafe">
              <span>♪ Today's Cafe BGM</span>
            </a>
          </div>
        </div>

        <div class="surface hidden max-w-xs shrink-0 p-5 lg:block">
          <p class="font-editorial text-xs italic tracking-[0.18em] text-[#B86B4B] uppercase">Cafe Note</p>
          <p class="mt-2 font-['Shippori_Mincho',serif] text-sm font-semibold text-[#2C221E]">本日のおすすめブレンド</p>
          <p class="mt-1.5 text-xs leading-relaxed text-[#6E5D53]">
            現在 <strong class="text-[#2C221E]">{games.length}作品</strong> をラインナップ中。個性豊かなアクション＆シューティングをお楽しみください。
          </p>
          <div class="mt-3 border-t border-dashed border-[#E6DEC8] pt-2.5 text-[11px] tracking-widest text-[#9C8B7E] uppercase">
            Open 24/7 · Free Entry
          </div>
        </div>
      </div>
    </div>
    <div class="mt-6"><AdBanner placement="トップページ上部" /></div>
  </section>

  <section id="games" class="page-shell py-14">
    <div class="flex flex-col gap-5 border-b border-[#E6DEC8] pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow"> Game Menu &amp; Lineup</p>
        <h2 class="mt-1 font-['Shippori_Mincho',serif] text-2xl font-semibold text-[#2C221E] sm:text-3xl">
          ゲームメニュー <span class="font-editorial ml-1 text-lg italic text-[#9C8B7E]">({games.length})</span>
        </h2>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="ジャンルで絞り込む">
        <button class="tag-filter rounded-full border border-[#2C221E] bg-[#2C221E] px-4 py-1.5 text-xs font-bold tracking-wider text-[#FBF9F5] transition" type="button" data-tag="all" aria-pressed="true">ALL</button>
        {tags.map((tag) => (
          <button class="tag-filter rounded-full border border-[#E6DEC8] bg-[#FFFFFF] px-4 py-1.5 text-xs font-medium text-[#6E5D53] transition hover:border-[#2C221E] hover:text-[#2C221E]" type="button" data-tag={tag} aria-pressed="false">#{tag}</button>
        ))}
      </div>
    </div>

    {games.length > 0 ? (
      <div id="game-grid" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {games.map((game, index) => (
          <div class="game-entry" data-tags={game.tags.join("|")}>
            <GameCard game={game} index={index} />
          </div>
        ))}
      </div>
    ) : (
      <p class="surface mt-8 p-10 text-center text-sm text-[#6E5D53]">ただいま新しいメニューを準備中です。もうしばらくお待ちください。</p>
    )}
    <p id="no-games-message" class="mt-8 hidden text-center text-sm text-[#9C8B7E]">このジャンルのゲームはまだありません。</p>
  </section>

  <div id="cafe-bgm" class="pb-12">
    <CafeBgmPlayer />
  </div>

  <section class="page-shell pb-12">
    <div class="surface-warm relative overflow-hidden p-6 sm:p-10">
      <div class="pointer-events-none absolute -right-12 -bottom-12 size-56 rounded-full bg-[#B86B4B]/10 blur-2xl"></div>
      <div class="relative z-10 flex flex-col justify-between gap-6 md:flex-row md:items-center">
        <div class="max-w-xl">
          <p class="eyebrow">Official Shop Card &amp; Links</p>
          <h2 class="mt-1 font-['Shippori_Mincho',serif] text-2xl font-semibold text-[#2C221E]">
            SARA Official Links · 壁紙＆SNS一覧
          </h2>
          <p class="mt-2.5 text-sm leading-7 text-[#6E5D53]">
            SARAのスマホ壁紙コレクションや最新のお知らせ、各種SNSアカウントは公式リンクページ（Linktree）にまとめています。ゲームの合間にぜひお立ち寄りください。
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="https://linktr.ee/sara_wallpaper68"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-espresso"
          >
            <span>Linktree を開く</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell pb-10">
    <div class="prose-copy surface p-6 sm:p-10">
      <p class="eyebrow">About Our Park</p>
      <h2 class="!mt-1">SARA Game Parkについて</h2>
      <p>SARA Game Parkは、インストールや会員登録をせずに遊べる、短時間で楽しめるブラウザーゲームを集めたカフェスタイルのゲームポータルです。ちょっとした空き時間やコーヒーブレイクに気軽に挑戦できるオリジナルゲームを順次追加していきます。各ゲームのページには操作方法や遊び方を掲載しています。</p>
      <p>最新のブラウザーを搭載したスマートフォン、タブレット、パソコンでの利用をおすすめします。ゲームによって画面の向きや操作方法が異なる場合があります。スマートフォンではタッチ操作、パソコンではクリックやキーボード操作で遊べます。</p>
      <h2 id="disclaimer">免責事項</h2>
      <p>ゲームの内容や動作は、予告なく変更・終了する場合があります。利用環境や端末によって正常に動作しないことがあります。プレイ中のデータはブラウザー内に保存される場合がありますが、保存を保証するものではありません。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
  const entries = document.querySelectorAll<HTMLElement>(".game-entry");
  const emptyMessage = document.querySelector<HTMLElement>("#no-games-message");

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selectedTag = filter.dataset.tag ?? "all";
      let visibleCount = 0;
      entries.forEach((entry) => {
        const visible = selectedTag === "all" || (entry.dataset.tags ?? "").split("|").includes(selectedTag);
        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      filters.forEach((button) => {
        const active = button === filter;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-[#2C221E]", active);
        button.classList.toggle("border-[#2C221E]", active);
        button.classList.toggle("text-[#FBF9F5]", active);
        button.classList.toggle("bg-[#FFFFFF]", !active);
        button.classList.toggle("border-[#E6DEC8]", !active);
        button.classList.toggle("text-[#6E5D53]", !active);
      });
      emptyMessage?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
