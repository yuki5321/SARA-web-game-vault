---
import AdBanner from "../components/AdBanner.astro";
import GameCard from "../components/GameCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGames } from "../lib/games";

const games = getGames();
const formattedGameCount = String(games.length).padStart(2, "0");
const tags = [...new Set(games.flatMap((game) => game.tags))].sort((a, b) => a.localeCompare(b, "ja"));
const description = "Noel（ノエル）は、インストール不要でブラウザから即座にプレイできる次世代Webゲームポータル。アクション・シューティング・タイピングなど多彩なゲームをPC・スマホで楽しめます。";
---

<BaseLayout title="Noel" description={description} gameCount={games.length}>
  <section class="page-shell pt-8 sm:pt-12">
    <div class="surface-cyber relative overflow-hidden px-6 py-12 sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-[#00F0FF]/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/4 size-80 rounded-full bg-[#A855F7]/15 blur-3xl"></div>

      <div class="relative z-10 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#00F0FF]/30 bg-[#06070B]/80 px-3.5 py-1 text-xs font-semibold tracking-wider text-[#00F0FF]">
            <span class="size-2 rounded-full bg-[#00F0FF] shadow-[0_0_8px_#00F0FF]"></span>
            <span class="font-mono-tech uppercase">SYSTEM READY // FREE TO PLAY</span>
          </div>
          <p class="font-cyber mt-5 text-xs font-bold tracking-[0.25em] text-[#9CA3B8] uppercase">Next-Gen Browser Arcade</p>
          <h1 class="mt-2 text-3xl font-black leading-tight tracking-tight text-white sm:text-5xl">
            漆黒の空間で没頭する、<br class="hidden sm:block" />
            <span class="bg-gradient-to-r from-[#00F0FF] via-[#F4F6FB] to-[#A855F7] bg-clip-text text-transparent">次世代ブラウザゲーム拠点。</span>
          </h1>
          <p class="mt-5 max-w-xl text-sm leading-7 text-[#9CA3B8] sm:text-base">
            インストール不要・登録不要。アクセスした瞬間からフルスピードで遊べるオリジナルアーケードタイトルをラインナップ。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#games" class="btn-neon">
              <span class="font-cyber">SELECT GAME</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <div class="surface hidden max-w-xs shrink-0 border-[#1E2438] p-5 lg:block">
          <p class="font-mono-tech text-xs font-bold tracking-[0.18em] text-[#00F0FF] uppercase">// STATUS MONITOR</p>
          <p class="mt-2 text-sm font-bold text-[#F4F6FB]">NOEL ARCADE SERVER</p>
          <p class="mt-1.5 text-xs leading-relaxed text-[#9CA3B8]">
            現在 <strong class="text-[#00F0FF]">{games.length} タイトル</strong> が稼働中。シューティング、2Dアクション、高速タイピングまで即座に起動可能です。
          </p>
          <div class="font-mono-tech mt-3 border-t border-[#1E2438] pt-2.5 text-[11px] tracking-widest text-[#5D647A] uppercase">
            ONLINE 24/7 · NO INSTALL
          </div>
        </div>
      </div>
    </div>
    <div class="mt-6"><AdBanner placement="トップページ上部" /></div>
  </section>

  <section id="games" class="page-shell py-14 sm:py-16">
    <div class="border-b border-[#1E2438] pb-7">
      <div class="flex flex-col gap-2">
        <p class="eyebrow">// EXPLORE THE ARCADE</p>
        <div class="mt-1 flex flex-wrap items-baseline gap-3">
          <h2 class="font-cyber text-3xl font-extrabold tracking-wider text-[#F4F6FB] sm:text-4xl">
            ARCADE COLLECTION
          </h2>
          <span class="font-mono-tech text-base font-bold tracking-widest text-[#00F0FF] sm:text-lg">
            [{formattedGameCount}]
          </span>
        </div>
        <p class="mt-1.5 text-sm leading-relaxed text-[#9CA3B8]">
          お気に入りのゲームを見つけよう。次のプレイが、ここから始まる。
        </p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2.5" role="group" aria-label="カテゴリーで絞り込む">
        <button
          class="tag-filter inline-flex h-9 cursor-pointer items-center justify-center rounded-lg border border-[#00F0FF] bg-[#00F0FF] px-4 text-xs font-extrabold tracking-wider text-[#06070B] shadow-[0_0_14px_rgba(0,240,255,0.3)] transition duration-200 hover:shadow-[0_0_18px_rgba(0,240,255,0.45)]"
          type="button"
          data-tag="all"
          aria-pressed="true"
        >
          ALL
        </button>
        {tags.map((tag) => (
          <button
            class="tag-filter inline-flex h-9 cursor-pointer items-center justify-center rounded-lg border border-[#1E2438] bg-[#0C0E16]/90 px-4 text-xs font-semibold tracking-wide text-[#9CA3B8] transition duration-200 hover:border-[#00F0FF]/50 hover:text-[#F4F6FB] hover:shadow-[0_0_12px_rgba(0,240,255,0.15)]"
            type="button"
            data-tag={tag}
            aria-pressed="false"
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    {games.length > 0 ? (
      <div id="game-grid" class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {games.map((game, index) => (
          <div class="game-entry" data-tags={game.tags.join("|")}>
            <GameCard game={game} index={index} />
          </div>
        ))}
      </div>
    ) : (
      <p class="surface mt-8 p-10 text-center text-sm text-[#9CA3B8]">現在タイトルを準備中です。</p>
    )}
    <p id="no-games-message" class="mt-8 hidden text-center text-sm text-[#5D647A]">このジャンルのゲームはまだありません。</p>
  </section>

  <section class="page-shell pb-10">
    <div class="prose-copy surface p-6 sm:p-10">
      <p class="eyebrow">// System Info</p>
      <h2 class="!mt-1">Noelについて</h2>
      <p>Noel（ノエル）は、インストールや会員登録をせずにブラウザー上で即座に遊べるオリジナルWebゲームポータルです。アクション、シューティング、タイピングなど、短時間でも熱中できるタイトルを順次追加しています。各ゲームのページには操作方法や攻略のコツを掲載しています。</p>
      <p>最新のブラウザーを搭載したスマートフォン、タブレット、パソコンでの利用をおすすめします。ゲームによって画面の向きや操作方法が異なる場合があります。スマートフォンではタッチ操作、パソコンではクリックやキーボード操作で遊べます。</p>
      <h2 id="disclaimer">免責事項</h2>
      <p>ゲームの内容や動作は、予告なく変更・終了する場合があります。利用環境や端末によって正常に動作しないことがあります。プレイ中のデータはブラウザー内に保存される場合がありますが、保存を保証するものではありません。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
  const entries = document.querySelectorAll<HTMLElement>(".game-entry");
  const emptyMessage = document.querySelector<HTMLElement>("#no-games-message");

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selectedTag = filter.dataset.tag ?? "all";
      let visibleCount = 0;
      entries.forEach((entry) => {
        const visible = selectedTag === "all" || (entry.dataset.tags ?? "").split("|").includes(selectedTag);
        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      filters.forEach((button) => {
        const active = button === filter;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-[#00F0FF]", active);
        button.classList.toggle("border-[#00F0FF]", active);
        button.classList.toggle("text-[#06070B]", active);
        button.classList.toggle("font-extrabold", active);
        button.classList.toggle("shadow-[0_0_14px_rgba(0,240,255,0.3)]", active);
        button.classList.toggle("bg-[#0C0E16]/90", !active);
        button.classList.toggle("border-[#1E2438]", !active);
        button.classList.toggle("text-[#9CA3B8]", !active);
        button.classList.toggle("font-semibold", !active);
      });
      emptyMessage?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
