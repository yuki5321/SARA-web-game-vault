---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title,
  description,
  gameCount = 0,
  canonicalPath = "/",
} = Astro.props;
const pageTitle = title === "Webゲーム倉庫" ? title : `${title} | Webゲーム倉庫`;
const normalizedCanonicalPath = canonicalPath === "/" ? "/" : `${canonicalPath.replace(/\/+$/, "")}/`;
const canonical = Astro.site ? new URL(normalizedCanonicalPath, Astro.site) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6d5dfc" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Webゲーム倉庫" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header gameCount={gameCount} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
