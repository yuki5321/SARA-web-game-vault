---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title,
  description,
  gameCount = 0,
  canonicalPath = "/",
} = Astro.props;
const pageTitle = title === "Noel" ? "Noel | Cyber Arcade Portal" : `${title} | Noel`;
const normalizedCanonicalPath = canonicalPath === "/" ? "/" : `${canonicalPath.replace(/\/+$/, "")}/`;
const canonical = Astro.site ? new URL(normalizedCanonicalPath, Astro.site) : undefined;
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070B" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Noel" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&family=Orbitron:wght@600;700;800;900&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header gameCount={gameCount} />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
